# Agentic Graph RAG — Runtime Settings
# Managed by Streamlit. Base .env is not modified.

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=
OPENAI_ROUTER_MODEL=deepseek-v4-flash
OPENAI_CYPHER_MODEL=deepseek-v4-flash
OPENAI_CORRECTOR_MODEL=deepseek-v4-flash
OPENAI_SYNTHESIS_MODEL=deepseek-v4-flash
OPENAI_RELATIONSHIP_DISCOVERY_MODEL=deepseek-v4-flash
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_LLM_TEMPERATURE=0.0

# Indexing
INDEXING_CHUNK_SIZE=1000
INDEXING_CHUNK_OVERLAP=200
INDEXING_SKELETON_BETA=0.25
INDEXING_KNN_K=10
INDEXING_PAGERANK_DAMPING=0.85

# Semantic Relations
INDEXING_SEMANTIC_RELATIONS_ENABLED=True
INDEXING_SEMANTIC_RELATION_TYPES=
INDEXING_SEMANTIC_RELATION_BATCH_SIZE=25
INDEXING_SEMANTIC_RELATION_MAX_PAIRS=60
INDEXING_SEMANTIC_RELATION_MIN_COOCCURRENCE=1
INDEXING_SEMANTIC_RELATION_MIN_CONFIDENCE=0.65
INDEXING_SEMANTIC_RELATION_CONTEXT_CHARS=1200
INDEXING_SEMANTIC_RELATION_MAX_PER_PAIR=4
INDEXING_SEMANTIC_RELATION_MODEL=
INDEXING_SEMANTIC_RELATION_TEMPERATURE=0.0

# Corpus Discovery
INDEXING_DISCOVERY_LLM_ENABLED=True
INDEXING_DISCOVERY_MAX_PAIRS=50
INDEXING_DISCOVERY_BATCH_SIZE=25
INDEXING_DISCOVERY_SAMPLE_CONTEXTS=3
INDEXING_DISCOVERY_MIN_EVIDENCE=1

# Relationship Discovery
RELATIONSHIP_DISCOVERY_ENABLED=true
RELATIONSHIP_DISCOVERY_MODE=both
RELATIONSHIP_DISCOVERY_MAX_DOCUMENTS=10
RELATIONSHIP_DISCOVERY_MAX_CHUNKS_PER_DOCUMENT=5
RELATIONSHIP_DISCOVERY_BATCH_SIZE=5
RELATIONSHIP_DISCOVERY_MAX_CANDIDATES=100
RELATIONSHIP_DISCOVERY_MIN_FREQUENCY=1
RELATIONSHIP_DISCOVERY_CONTEXT_WINDOW=12
RELATIONSHIP_DISCOVERY_MAX_RELATIONSHIPS_PER_CHUNK=20
RELATIONSHIP_DISCOVERY_USE_APPROVED_SCHEMA=true
RELATIONSHIP_DISCOVERY_SCHEMA_PATH=config/relationship_schema.json

# Retrieval
RETRIEVAL_TOP_K_VECTOR=10
RETRIEVAL_TOP_K_FINAL=10
RETRIEVAL_VECTOR_THRESHOLD=0.5
RETRIEVAL_MAX_HOPS=3
RETRIEVAL_PPR_ALPHA=0.15

# Agent
AGENT_MAX_RETRIES=2
AGENT_RELEVANCE_THRESHOLD=2.0
