FROM python:3.12-slim

# Системные зависимости (включая нужные для docling)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    git \
    pkg-config \
    libgl1 \
    libglib2.0-0 \
    poppler-utils \
    tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Обновляем pip
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# === БАЗОВЫЕ ЗАВИСИМОСТИ ===
RUN pip install --no-cache-dir \
    streamlit>=1.30.0 \
    neo4j>=5.0.0 \
    openai>=1.0.0 \
    httpx>=0.27.0 \
    pydantic>=2.0.0 \
    pydantic-settings>=2.0.0 \
    python-dotenv>=1.0.0 \
    numpy>=1.26.0 \
    scipy>=1.11.0 \
    networkx>=3.0 \
    lark>=1.1.0 \
    tiktoken>=0.5.0 \
    pandas>=2.0.0 \
    requests>=2.31.0 \
    tenacity>=8.2.0 \
    fastapi>=0.115.0 \
    uvicorn>=0.30.0

# === ПРОБЛЕМНЫЕ ПАКЕТЫ (если не поставятся — не страшно) ===
RUN pip install --no-cache-dir docling>=2.0.0 || echo "WARNING: docling not installed"
RUN pip install --no-cache-dir graphiti-core>=0.26.0 || echo "WARNING: graphiti-core not installed"
RUN pip install --no-cache-dir fastmcp>=2.0.0 || echo "WARNING: fastmcp not installed"
RUN pip install --no-cache-dir sentence-transformers || echo "WARNING: sentence-transformers not installed"

# Копируем код
COPY . .

# Устанавливаем локальный пакет rag-core
RUN if [ -f packages/rag-core/pyproject.toml ] || [ -f packages/rag-core/setup.py ]; then \
        echo "Устанавливаем rag-core..." && \
        pip install --no-cache-dir -e ./packages/rag-core --no-deps || true; \
    fi

# Устанавливаем pymangle
RUN if [ -f pymangle/pyproject.toml ] || [ -f pymangle/setup.py ]; then \
        echo "Устанавливаем pymangle..." && \
        pip install --no-cache-dir -e ./pymangle --no-deps || true; \
    fi

# PYTHONPATH как страховка
ENV PYTHONPATH=/app:/app/pymangle:/app/packages/rag-core:/app/packages
ENV PYTHONUNBUFFERED=1

EXPOSE 8506

CMD ["streamlit", "run", "ui/streamlit_app.py", \
     "--server.port=8506", \
     "--server.address=0.0.0.0", \
     "--server.headless=true"]
